{
  "rules": {
    "lobby": {
      ".read": "auth != null",
      "$rid": {
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || data.child('host').val() === auth.uid || (!newData.exists() && data.child('at').val() < now - 120000))",
        ".validate": "newData.hasChildren(['host', 'name', 'at']) && newData.child('name').isString() && newData.child('name').val().length <= 40"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && auth.provider !== 'anonymous'"
      }
    },
    "pub": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid && auth.provider !== 'anonymous'"
      }
    },
    "codes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && auth.provider !== 'anonymous' && !data.exists() && newData.val() === auth.uid"
      }
    },
    "req": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".write": "auth != null && auth.provider !== 'anonymous' && (auth.uid === $to || (auth.uid === $from && $from !== $to))"
        }
      }
    },
    "friends": {
      "$a": {
        ".read": "auth != null && auth.uid === $a",
        "$b": {
          ".write": "auth != null && auth.provider !== 'anonymous' && (auth.uid === $a || (auth.uid === $b && (!newData.exists() || root.child('req/' + $b + '/' + $a).exists())))"
        }
      }
    },
    "inv": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$i": {
          ".write": "auth != null && ((!data.exists() && newData.child('from').val() === auth.uid && root.child('friends/' + $to + '/' + auth.uid).exists()) || (auth.uid === $to && !newData.exists()))"
        }
      }
    },
    "games": {
      "$g": {
        ".read": "auth != null",
        ".write": "auth != null && !newData.exists() && data.child('host').val() === auth.uid",
        "host": {
          ".write": "auth != null && (data.val() === auth.uid || (newData.val() === auth.uid && (!data.exists() || ((!root.child('games/' + $g + '/on/' + data.val()).exists() || root.child('games/' + $g + '/hb').val() < now - 10000) && root.child('games/' + $g + '/on/' + auth.uid).exists()))))"
        },
        "rid": {
          ".write": "auth != null && (root.child('games/' + $g + '/host').val() === auth.uid || newData.parent().child('host').val() === auth.uid)"
        },
        "hb": {
          ".write": "auth != null && root.child('games/' + $g + '/host').val() === auth.uid"
        },
        "s": {
          ".write": "auth != null && (root.child('games/' + $g + '/host').val() === auth.uid || newData.parent().child('host').val() === auth.uid)"
        },
        "acts": {
          "$a": {
            ".write": "auth != null && ((!data.exists() && newData.child('by').val() === auth.uid) || (!newData.exists() && root.child('games/' + $g + '/host').val() === auth.uid))",
            ".validate": "newData.child('a').isString() && newData.child('a').val().length < 200000"
          }
        },
        "mv": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || (!newData.exists() && root.child('games/' + $g + '/host').val() === auth.uid))"
          }
        },
        "on": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },
    "reports": {
      "$id": {
        ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid && newData.parent().parent().child('reportsLast/' + auth.uid).val() === now",
        ".validate": "newData.hasChildren(['at', 'uid', 'name', 'device', 'browser', 'text'])",
        "at": {
          ".validate": "newData.val() === now"
        },
        "uid": {
          ".validate": "newData.val() === auth.uid"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 20 && !newData.val().contains('@')"
        },
        "device": {
          ".validate": "newData.isString() && newData.val().matches(/^(Phone|Tablet|Computer|Touchscreen laptop or computer)$/)"
        },
        "browser": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 1000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "reportsLast": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && (!data.exists() || data.val() < now - 60000)",
        ".validate": "newData.val() === now"
      }
    }
  }
}
